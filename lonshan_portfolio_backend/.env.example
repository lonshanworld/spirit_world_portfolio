# NestJS World Engine — Environment Variables
# Copy this to .env and fill in your values

# ── Gemini AI ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# Model used: gemini-3-flash-live
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL ───────────────────────────────────────────────────
# Dialogue history is persisted here (table auto-created on startup)
# If omitted, falls back to tiny in-memory buffer (no persistence)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ───────────────────────────────────────────────────────
PORT=3001

# ── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
